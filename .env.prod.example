DB_USER=root
DB_PASS=password
DB_NAME=peekaping
DB_HOST=database
DB_PORT=5432
DB_TYPE=postgres
# PostgreSQL TLS: disable (default), allow, prefer, require, verify-ca, verify-full
DB_SSLMODE=disable
# SQLite is the other option for new installs: DB_TYPE=sqlite and DB_NAME=/app/data/peekaping.db (no DB_HOST, DB_PORT, DB_USER or DB_PASS)

SERVER_PORT=8034
CLIENT_URL="http://localhost:5173"

MODE=prod # logging
TZ="America/New_York"

REDIS_HOST="redis"
REDIS_PORT=6379
# Redis ACL user; leave empty for password-only/default user auth
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_DB=0

# The token of the local probe, which checks the monitors that run on Peekaping itself. The api
# stores it at startup and the compose files' probe service sends it. It gives access to the
# config of those monitors, so make it a random string of at least 32 characters, such as the
# output of: openssl rand -hex 32
# The SQLite and PostgreSQL compose files refuse to start while it is empty.
PROBE_BOOTSTRAP_TOKEN=

# Set to true to expose the unauthenticated Prometheus /metrics endpoint (off by default).
# METRICS_ENABLED=false

# How many days the hourly cleanup keeps notification history (default 90, at least 30) and
# monitor TLS info (default 30, at least 1).
# NOTIFICATION_HISTORY_RETENTION_DAYS=90
# TLS_INFO_RETENTION_DAYS=30

# Origins whose pages may read the API's responses, comma-separated. Empty allows the origin of
# CLIENT_URL. Set it when the web app is served from another origin. "*" allows any origin.
# CORS_ORIGINS=https://peek.example.com
