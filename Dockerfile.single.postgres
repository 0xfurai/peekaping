# The PostgreSQL bundle: Peekaping in single mode (ADR 0002) beside its own PostgreSQL 17.
# peekaping serves the web app, the API and the websocket on port 8383; PostgreSQL keeps its
# cluster in /var/lib/postgresql/data.

# Stage 1: Build peekaping and the migration tool
FROM golang:1.26.4-alpine AS go-builder

RUN apk add --no-cache git
WORKDIR /app/server
COPY apps/server/go.mod apps/server/go.sum ./
RUN go mod download
COPY apps/server/ .
RUN CGO_ENABLED=0 GOFLAGS="-trimpath" go build -o peekaping -ldflags="-s -w" ./cmd/peekaping
RUN CGO_ENABLED=0 GOFLAGS="-trimpath" go build -o bun -ldflags="-s -w" ./cmd/bun

# Stage 2: Build the web app
FROM node:22-alpine AS web-builder

WORKDIR /app
# Bun, at the version pinned in package.json
COPY --from=oven/bun:1.4.3-alpine /usr/local/bin/bun /usr/local/bin/bun
COPY package.json bun.lock ./
COPY apps/web/package.json ./apps/web/package.json
RUN bun install --frozen-lockfile --filter web
COPY apps/web/ ./apps/web/
WORKDIR /app/apps/web
RUN bun run build

# Stage 3: Runtime. Debian's glibc, as in earlier bundles, so existing clusters keep their
# collation: their text indexes stay valid.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# The postgres user keeps the IDs it had in earlier bundles, so the cluster's files keep their
# owner across an upgrade or a rollback
RUN groupadd -r -g 105 postgres \
    && useradd -r -u 102 -g postgres -d /var/lib/postgresql -s /bin/bash postgres

# tini runs as PID 1 and passes docker stop's SIGTERM to the startup script. gosu drops root
# for PostgreSQL and peekaping. nss_wrapper gives initdb a user name under docker run --user.
# netcat is for run-migrations.sh, curl for the health check.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gosu \
        libnss-wrapper \
        locales \
        netcat-openbsd \
        tini \
    && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen \
    && rm -rf /var/lib/apt/lists/*

# The cluster was initialized in this locale, which it needs to start
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# PostgreSQL 17 from the PGDG repository, without the default cluster: the startup script
# initializes its own in PGDATA
RUN . /etc/os-release \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /usr/share/keyrings/postgresql.asc \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql.asc] http://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && mkdir -p /etc/postgresql-common/createcluster.d \
    && echo 'create_main_cluster = false' > /etc/postgresql-common/createcluster.d/peekaping.conf \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-17 postgresql-client-17 postgresql-contrib-17 \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/lib/postgresql/17/bin:$PATH"
ENV PGDATA="/var/lib/postgresql/data"

# Any user may create PostgreSQL's socket, so that it also runs under docker run --user
RUN mkdir -p "$PGDATA" \
    && chown -R postgres:postgres /var/lib/postgresql \
    && chmod 700 "$PGDATA" \
    && mkdir -p /var/run/postgresql \
    && chown postgres:postgres /var/run/postgresql \
    && chmod 3777 /var/run/postgresql

# The user peekaping runs as; startup.user.sh applies PUID/PGID
RUN groupadd -g 1000 peekaping \
    && useradd -u 1000 -g peekaping -M -d /nonexistent -s /usr/sbin/nologin peekaping \
    && mkdir -p /app/data \
    && chown peekaping:peekaping /app/data

COPY --from=go-builder --chmod=755 /app/server/peekaping /app/server/bun /app/server/
COPY --from=go-builder --chmod=755 /app/server/scripts/run-migrations.sh /app/server/run-migrations.sh
COPY --from=web-builder /app/apps/web/dist /app/web
COPY --chmod=755 startup.single.postgres.sh /app/startup.sh
COPY startup.single.user.sh /app/startup.user.sh

# peekaping serves the web build itself and generates /env.js. The startup script forces
# SERVER_PORT to 8383, whatever the .env says.
ENV WEB_DIR=/app/web

WORKDIR /app/server
EXPOSE 8383

# peekaping takes up to 30 seconds to shut down, and PostgreSQL stops after it; give docker
# stop -t 35 or stop_grace_period: 35s so neither is killed halfway
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --start-interval=2s --retries=3 \
    CMD curl -fsS -o /dev/null http://127.0.0.1:8383/api/v1/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/app/startup.sh"]
