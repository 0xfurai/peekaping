---
import SectionHeading from "./SectionHeading.astro";
import { channelGroups, channelCount } from "../data/integrations";

const names = channelGroups.flatMap((group) => group.items.map((item) => item.name));
const half = Math.ceil(names.length / 2);
const rows = [names.slice(0, half), names.slice(half)];
---

<section id="alerts" class="relative py-24 sm:py-32">
  <div class="px-4 sm:px-8">
    <SectionHeading eyebrow="Alerts" title={`${channelCount} channels. <span class='text-gradient'>Zero excuses.</span>`}>
      Route each monitor to the people who can fix it, and hear when it's back up.
    </SectionHeading>
  </div>

  <!-- Marquee -->
  <div
    class="reveal space-y-3 [mask-image:linear-gradient(90deg,transparent,#000_12%,#000_88%,transparent)]"
    aria-hidden="true"
  >
    {
      rows.map((row, r) => (
        <div class="flex overflow-hidden">
          <div
            class="flex shrink-0 gap-3 pr-3 animate-marquee hover:[animation-play-state:paused]"
            style={r === 1 ? "animation-direction: reverse; animation-duration: 48s" : undefined}
          >
            {[...row, ...row].map((name) => (
              <span class="whitespace-nowrap rounded-full border border-white/10 bg-white/[0.03] px-5 py-2.5 text-sm font-medium text-zinc-200">
                {name}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <div class="px-4 sm:px-8 mt-14">
    <div class="max-w-screen-lg mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-x-8 gap-y-10">
      {
        channelGroups.map((group, i) => (
          // The longest group gets two columns so the rows end together
          <div class:list={["reveal", { "sm:col-span-2": i === 0 }]} style={`--delay:${i * 60}ms`}>
            <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-zinc-500">{group.title}</h3>
            <ul class:list={["mt-4 text-sm", i === 0 ? "sm:columns-2 gap-x-8" : ""]}>
              {group.items.map((item) => (
                <li class="mb-2.5 break-inside-avoid">
                  <strong class="font-semibold text-zinc-100">{item.name}</strong>
                  <span class="block text-zinc-500">{item.description}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
