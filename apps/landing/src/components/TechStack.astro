---
import { monitorCount, channelCount } from "../data/integrations";

const stats = [
  { value: String(monitorCount), label: "monitor types" },
  { value: String(channelCount), label: "alert channels" },
  { value: "100%", label: "open source, MIT" },
  { value: "0", label: "vendor lock-in" },
];

const stack = ["Go", "React", "TypeScript", "SQLite", "PostgreSQL", "Docker", "Kubernetes"];
---

<section class="px-4 sm:px-8 pt-8 pb-4">
  <div class="max-w-screen-lg mx-auto">
    <dl class="grid grid-cols-2 lg:grid-cols-4 gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/10">
      {
        stats.map((stat, i) => (
          <div class="reveal bg-ink px-6 py-8 text-center" style={`--delay:${i * 70}ms`}>
            <dt class="sr-only">{stat.label}</dt>
            <dd class="text-4xl sm:text-5xl font-bold tracking-tight text-gradient">{stat.value}</dd>
            <dd class="mt-2 text-sm text-zinc-400">{stat.label}</dd>
          </div>
        ))
      }
    </dl>

    <div class="reveal mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm">
      <span class="text-zinc-500">Built with</span>
      {stack.map((name) => <span class="font-semibold text-zinc-300">{name}</span>)}
    </div>
  </div>
</section>
