---
const { question, answer } = Astro.props;
---

<details
  class="group rounded-2xl border border-white/10 bg-white/[0.025] open:bg-white/[0.045] open:border-violet-400/25 transition-colors"
>
  <summary class="flex items-center gap-4 cursor-pointer list-none px-6 py-5">
    <span class="flex-1 text-lg font-semibold text-white">{question}</span>
    <span
      class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-white/10 text-zinc-400 transition-transform duration-300 group-open:rotate-45 group-open:text-violet-300"
      aria-hidden="true"
    >
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M7 2V12M2 7H12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </span>
  </summary>

  <div class="px-6 pb-6 -mt-1 text-zinc-400 leading-relaxed">
    {answer}
  </div>
</details>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
