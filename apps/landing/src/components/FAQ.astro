---
import SectionHeading from "./SectionHeading.astro";
import FAQItem from "./FAQItem.astro";
import faqItems from "../data/faq";
---

<section id="faq" class="px-4 sm:px-8 py-24 sm:py-32">
  <div class="max-w-3xl mx-auto">
    <SectionHeading eyebrow="FAQ" title="Still <span class='text-gradient'>got questions?</span>" />

    <div class="reveal space-y-3">
      {faqItems.map((item) => <FAQItem question={item.question} answer={item.answer} />)}
    </div>
  </div>
</section>
