---
import GitHubIcon from "./GitHubIcon.astro";
const today = new Date();

const links = [
  { href: "/#features", label: "Features" },
  { href: "/#monitors", label: "Monitors" },
  { href: "/#alerts", label: "Alerts" },
  { href: "/#faq", label: "FAQ" },
  { href: "https://docs.peekaping.com", label: "Docs", external: true },
  { href: "https://demo.peekaping.com", label: "Demo", external: true },
];
---

<footer class="px-4 sm:px-8 pt-16">
  <!-- Closing call to action -->
  <div
    class="reveal relative max-w-screen-lg mx-auto mt-24 rounded-[2rem] border border-white/10 overflow-hidden"
  >
    <div class="absolute inset-0 bg-[url(/hero-section-bg.webp)] bg-cover bg-center opacity-90" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#1a0f33]/90 via-[#1a0f33]/40 to-transparent" aria-hidden="true"></div>
    <div class="absolute inset-0 grid-bg opacity-60" aria-hidden="true"></div>

    <div class="relative px-6 sm:px-16 pt-16 sm:pt-20 pb-14 sm:pb-16 text-center">
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white leading-[1.1] max-w-2xl mx-auto">
        Your services are talking. Start listening.
      </h2>
      <p class="mt-5 text-lg text-white/80 max-w-xl mx-auto">
        Spin it up fast, track checks in real time, publish status pages, and get alerts only when
        it actually matters.
      </p>
      <div class="mt-9 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/#quickstart" class="btn-primary">Get started <span aria-hidden="true">→</span></a>
        <a href="https://demo.peekaping.com" target="_blank" class="btn-ghost bg-black/20">Try the live demo</a>
      </div>
    </div>

    <img
      src="/meerkat.webp"
      alt=""
      width="1028"
      height="1028"
      loading="lazy"
      class="hidden sm:block absolute -bottom-10 -right-6 w-[190px] lg:w-[230px] drop-shadow-[0_20px_30px_rgba(0,0,0,0.5)]"
    />
  </div>

  <div class="max-w-screen-lg mx-auto py-12 flex flex-col md:flex-row gap-8 md:items-center justify-between">
    <a href="/" class="flex items-center gap-2.5">
      <img src="/logo-mascot.webp" alt="" width="40" height="40" class="w-10 h-10" />
      <span class="text-lg font-bold text-white">Peekaping</span>
    </a>

    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-zinc-400">
        {
          links.map((link) => (
            <li>
              <a href={link.href} target={link.external ? "_blank" : undefined} class="hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 text-zinc-400">
      <a href="https://x.com/0xfurai" target="_blank" class="p-2 rounded-full hover:text-white hover:bg-white/5 transition-colors">
        <span class="sr-only">Follow 0xfurai on X</span>
        <svg width="18" height="18" viewBox="0 0 21 21" fill="currentColor" aria-hidden="true">
          <path d="M16.0355 1.66602H18.9873L12.5385 9.03657L20.125 19.0662H14.1848L9.53228 12.9833L4.2087 19.0662H1.25513L8.15275 11.1826L0.875 1.66602H6.96597L11.1715 7.22606L16.0355 1.66602ZM14.9995 17.2994H16.6351L6.07722 3.34001H4.32203L14.9995 17.2994Z"></path>
        </svg>
      </a>
      <a href="https://github.com/0xfurai/peekaping" target="_blank" class="p-2 rounded-full hover:text-white hover:bg-white/5 transition-colors">
        <span class="sr-only">Go to Peekaping's GitHub repo</span>
        <GitHubIcon size={18} />
      </a>
      <a href="https://discord.gg/Xuv8b5AhPF" target="_blank" class="p-2 rounded-full hover:text-white hover:bg-white/5 transition-colors">
        <span class="sr-only">Go to Peekaping's Discord</span>
        <svg width="18" height="18" viewBox="0 0 21 21" fill="currentColor" aria-hidden="true">
          <path d="M17.7774 3.63594C16.4389 3.0218 15.0036 2.56932 13.5029 2.31017C13.4756 2.30517 13.4483 2.31767 13.4342 2.34267C13.2496 2.67098 13.0451 3.09929 12.902 3.43594C11.2879 3.19429 9.68203 3.19429 8.10103 3.43594C7.95782 3.09181 7.74592 2.67098 7.5605 2.34267C7.54642 2.3185 7.51912 2.306 7.49179 2.31017C5.99192 2.56849 4.55662 3.02097 3.21732 3.63594C3.20572 3.64094 3.19579 3.64928 3.18919 3.66011C0.466718 7.72742 -0.279081 11.6948 0.0867826 15.6129C0.0884381 15.6321 0.0991986 15.6504 0.114098 15.6621C1.91031 16.9812 3.65024 17.782 5.35787 18.3128C5.3852 18.3211 5.41415 18.3111 5.43155 18.2886C5.83549 17.737 6.19556 17.1554 6.50429 16.5437C6.52251 16.5079 6.50512 16.4654 6.46788 16.4512C5.89674 16.2346 5.3529 15.9704 4.82976 15.6704C4.78838 15.6463 4.78507 15.5871 4.82314 15.5587C4.93323 15.4762 5.04334 15.3904 5.14846 15.3038C5.16748 15.2879 5.19398 15.2846 5.21634 15.2946C8.65312 16.8637 12.3739 16.8637 15.7701 15.2946C15.7924 15.2838 15.8189 15.2871 15.8388 15.3029C15.9439 15.3896 16.054 15.4762 16.1649 15.5587C16.203 15.5871 16.2005 15.6463 16.1591 15.6704C15.636 15.9762 15.0922 16.2346 14.5202 16.4504C14.483 16.4645 14.4664 16.5079 14.4846 16.5437C14.8 17.1545 15.16 17.7361 15.5565 18.2878C15.5731 18.3111 15.6029 18.3211 15.6302 18.3128C17.3461 17.782 19.086 16.9812 20.8823 15.6621C20.898 15.6504 20.9079 15.6329 20.9096 15.6138C21.3474 11.0839 20.1762 7.14913 17.8047 3.66094C17.7989 3.64928 17.789 3.64094 17.7774 3.63594ZM7.01752 13.2272C5.98281 13.2272 5.13024 12.2772 5.13024 11.1106C5.13024 9.94399 5.96628 8.99405 7.01752 8.99405C8.07701 8.99405 8.92133 9.95233 8.90477 11.1106C8.90477 12.2772 8.06873 13.2272 7.01752 13.2272ZM13.9954 13.2272C12.9607 13.2272 12.1082 12.2772 12.1082 11.1106C12.1082 9.94399 12.9442 8.99405 13.9954 8.99405C15.0549 8.99405 15.8992 9.95233 15.8827 11.1106C15.8827 12.2772 15.0549 13.2272 13.9954 13.2272Z"></path>
        </svg>
      </a>
    </div>
  </div>

  <div
    class="max-w-screen-lg mx-auto border-t border-white/10 py-8 text-sm text-zinc-500 flex flex-col sm:flex-row gap-4 items-center justify-between"
  >
    <div>&copy; {today.getFullYear()} Peekaping. All rights reserved.</div>
    <div class="flex gap-6">
      <a href="/privacy-policy" class="hover:text-zinc-300 transition-colors">Privacy Policy</a>
      <a href="/terms-and-conditions" class="hover:text-zinc-300 transition-colors">Terms and Conditions</a>
    </div>
    <div>Made with 💜 by the Peekaping team</div>
  </div>
</footer>
