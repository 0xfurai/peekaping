---
import HeaderLink from "./HeaderLink.astro";
import GitHubIcon from "./GitHubIcon.astro";
---

<header class="sticky top-3 sm:top-5 z-50 px-4">
  <nav
    class="flex justify-between items-center py-1.5 pl-2 pr-1.5 rounded-full max-w-screen-lg mx-auto mt-3 sm:mt-5 border border-white/10 bg-[#0d0a17]/70 backdrop-blur-xl shadow-[0_8px_32px_-12px_rgba(0,0,0,0.8)] text-zinc-300"
  >
    <a href="/" class="flex gap-2 items-center">
      <img src="/logo-mascot.webp" alt="" width="40" height="40" class="w-9 h-9 sm:w-10 sm:h-10" />
      <span class="text-base sm:text-lg font-bold text-white tracking-tight">Peekaping</span>
    </a>

    <div class="hidden md:flex gap-7 text-sm">
      <HeaderLink href="/#features">Features</HeaderLink>
      <HeaderLink href="/#monitors">Monitors</HeaderLink>
      <HeaderLink href="/#alerts">Alerts</HeaderLink>
      <HeaderLink href="/#quickstart">Quickstart</HeaderLink>
      <HeaderLink href="https://docs.peekaping.com" target="_blank">Docs</HeaderLink>
    </div>

    <div class="flex gap-2 items-center">
      <a
        href="https://github.com/0xfurai/peekaping"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center justify-center w-10 h-10 rounded-full text-zinc-300 hover:text-white hover:bg-white/5 transition-colors"
      >
        <span class="sr-only">Go to Peekaping's GitHub repo</span>
        <GitHubIcon size={22} />
      </a>
      <a
        href="/#quickstart"
        class="bg-white text-[#0b0713] text-sm font-semibold px-4 py-2.5 rounded-full hover:bg-violet-100 transition-colors"
      >
        Get started
      </a>
    </div>
  </nav>
</header>
