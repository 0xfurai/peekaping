---
import SectionHeading from "./SectionHeading.astro";
import { monitorGroups, monitorCount } from "../data/integrations";
---

<section id="monitors" class="relative overflow-hidden px-4 sm:px-8 py-24 sm:py-32">
  <div
    class="absolute left-1/2 top-1/3 -translate-x-1/2 w-[700px] h-[400px] rounded-full bg-violet-700/15 blur-[120px] -z-10"
    aria-hidden="true"
  >
  </div>
  <div class="max-w-screen-lg mx-auto">
    <SectionHeading eyebrow="Monitors" title={`${monitorCount} ways to <span class='text-gradient'>check your stack</span>`}>
      From the website on the edge to the queue in the basement.
    </SectionHeading>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {
        monitorGroups.map((group, i) => (
          <div class="glow-card reveal p-6 sm:p-7" style={`--delay:${(i % 2) * 80}ms`}>
            <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-zinc-500">{group.title}</h3>
            <ul class="mt-5 space-y-3.5">
              {group.items.map((item) => (
                <li class="flex items-baseline gap-3">
                  <span class="h-1.5 w-1.5 shrink-0 translate-y-[-2px] rounded-full bg-up shadow-[0_0_10px_rgba(34,197,94,0.8)]" />
                  <span>
                    <strong class="font-semibold text-white">{item.name}</strong>
                    <span class="text-zinc-400"> — {item.description}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
