	}

	if err := validation.Validate.Struct(entity); err != nil {
		return nil, httpx.Fail(http.StatusBadRequest, utils.NewFailResponse(err.Error()))
	}

	createdEntity, err := c.service.Create(ctx, entity)
	if err != nil {
		c.logger.Errorw("Failed to create {{.ModuleName}}", "error", err)
		return nil, httpx.Fail(http.StatusInternalServerError, utils.NewFailResponse("Internal server error"))
	}

	return httpx.Reply(http.StatusCreated, utils.NewSuccessResponse("{{.ModuleName | pascal}} created successfully", createdEntity))
}
