POST https://api.pagertree.com/integration/int_123
Content-Type: application/json

{
  "event_type": "create",
  "id": "monitor-mon-1-<unix-time>",
  "title": "Monitor Public API Alert",
  "description": "🚨 Certificate Expiry Warning\n\nMonitor: Public API\nCertificate: api.example.com (server)\nExpires in: 7 days\nValid until: 2026-10-24 09:30:00\nNotification threshold: 7 days\nValid for: api.example.com\nIssuer: CN=R11,O=Let's Encrypt,C=US",
  "urgency": "medium",
  "tags": [
    "peekaping",
    "monitor-type:http"
  ],
  "meta": {
    "monitor_id": "mon-1",
    "monitor_name": "Public API",
    "monitor_type": "http",
    "monitor_url": "https://api.example.com/health"
  }
}
