POST https://events.pagerduty.com/v2/enqueue
Content-Type: application/json
User-Agent: Peekaping-PagerDuty/<version>

{
  "client": "Peekaping",
  "client_url": "https://peekaping.example.com/monitors/mon-1",
  "dedup_key": "Peekaping/mon-1",
  "event_action": "trigger",
  "payload": {
    "severity": "warning",
    "source": "https://api.example.com/health",
    "summary": "[Peekaping Alert] [Public API] 🚨 Certificate Expiry Warning\n\nMonitor: Public API\nCertificate: api.example.com (server)\nExpires in: 7 days\nValid until: 2026-10-24 09:30:00\nNotification threshold: 7 days\nValid for: api.example.com\nIssuer: CN=R11,O=Let's Encrypt,C=US"
  },
  "routing_key": "routing-key"
}
