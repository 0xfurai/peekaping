{
  "name": "mono",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev:api",
    "dev:probe": "turbo run dev:probe",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "e2e": "playwright test",
    "api:generate": "bun run --filter server docs:generate && bun run --filter web gen",
    "api:validate": "redocly lint apps/server/docs/openapi.json",
    "api:check": "bun run api:generate && bun run api:validate && sh scripts/check-api-artifacts.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@redocly/cli": "1.34.3",
    "@types/node": "22.15.17",
    "nodemon": "^3.1.10",
    "prettier": "3.6.2",
    "turbo": "^2.5.4"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22"
  }
}
