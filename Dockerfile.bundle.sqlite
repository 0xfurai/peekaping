# The SQLite bundle: Peekaping in single mode (ADR 0002). One process, peekaping, serves the
# web app, the API and the websocket on port 8383 and stores its data in /app/data.

# Stage 1: Build peekaping and the migration tool
FROM golang:1.26.4-alpine AS go-builder

RUN apk add --no-cache git
WORKDIR /app/server
COPY apps/server/go.mod apps/server/go.sum ./
RUN go mod download
COPY apps/server/ .
RUN CGO_ENABLED=0 GOFLAGS="-trimpath" go build -o peekaping -ldflags="-s -w" ./cmd/peekaping
# No -trimpath: bun reads its SQL migrations at runtime from the path it was built at,
# /app/server/cmd/bun/migrations, which the runtime stage copies them to.
RUN CGO_ENABLED=0 go build -o bun -ldflags="-s -w" ./cmd/bun

# Stage 2: Build the web app
FROM node:22-alpine AS web-builder

WORKDIR /app
# Bun, at the version pinned in package.json
COPY --from=oven/bun:1.4.3-alpine /usr/local/bin/bun /usr/local/bin/bun
COPY package.json bun.lock ./
COPY apps/web/package.json ./apps/web/package.json
RUN bun install --frozen-lockfile --filter web
COPY apps/web/ ./apps/web/
WORKDIR /app/apps/web
RUN bun run build

# Stage 3: Runtime
FROM alpine:3.24

# tini runs as PID 1 and passes docker stop's SIGTERM to peekaping. su-exec drops root for
# peekaping, and shadow's groupmod and usermod apply PUID and PGID (startup.user.sh). Ping
# monitors fall back to busybox's ping where they can't open an ICMP socket themselves.
RUN apk add --no-cache ca-certificates tini su-exec shadow

# The user peekaping runs as; startup.user.sh applies PUID/PGID
RUN addgroup -g 1000 peekaping \
    && adduser -u 1000 -G peekaping -H -D -h /nonexistent -s /sbin/nologin peekaping \
    && mkdir -p /app/data \
    && chown peekaping:peekaping /app/data

COPY --from=go-builder --chmod=755 /app/server/peekaping /app/server/bun /app/server/
COPY --from=go-builder /app/server/cmd/bun/migrations /app/server/cmd/bun/migrations
COPY --from=go-builder --chmod=755 /app/server/scripts/run-migrations.sh /app/server/run-migrations.sh
COPY --from=web-builder /app/apps/web/dist /app/web
COPY --chmod=755 startup.bundle.sqlite.sh /app/startup.sh
COPY startup.bundle.user.sh /app/startup.user.sh

# peekaping serves the web build itself and generates /env.js. The startup script sets the
# database and forces SERVER_PORT to 8383, whatever the .env says.
ENV WEB_DIR=/app/web \
    TZ=UTC

WORKDIR /app/server
EXPOSE 8383

# peekaping takes up to 30 seconds to shut down; give docker stop -t 35 or
# stop_grace_period: 35s so it isn't killed halfway
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --start-interval=2s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8383/api/v1/health || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/app/startup.sh"]
