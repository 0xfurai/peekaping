DB_USER=root
DB_PASS=password
DB_NAME=peekaping
DB_HOST=localhost
DB_PORT=5432
DB_TYPE=postgres

SERVER_PORT=8034
CLIENT_URL="http://localhost:5173"

MODE=dev # logging
TZ="America/New_York"


REDIS_HOST="localhost"
REDIS_PORT=6381
# Redis ACL user; leave empty for password-only/default user auth
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_DB=0

# The local probe, which checks the monitors that run on Peekaping itself. `make dev` runs a probe
# next to the api: the api stores PROBE_BOOTSTRAP_TOKEN as the local probe's token, and the probe
# sends PROBE_TOKEN to PEEKAPING_URL.
# The two tokens must be equal, and at least 32 characters. The Docker Compose dev stacks read
# PROBE_BOOTSTRAP_TOKEN for both and refuse to start without it.
PROBE_BOOTSTRAP_TOKEN=dev-local-probe-token-0123456789abcdef
PROBE_TOKEN=dev-local-probe-token-0123456789abcdef
PEEKAPING_URL=http://localhost:8034

# Set to true to expose the unauthenticated Prometheus /metrics endpoint (off by default).
# METRICS_ENABLED=false

# How many days the hourly cleanup keeps notification history (default 90, at least 30) and
# monitor TLS info (default 30, at least 1).
# NOTIFICATION_HISTORY_RETENTION_DAYS=90
# TLS_INFO_RETENTION_DAYS=30

# Origins whose pages may read the API's responses, comma-separated. Empty allows the origin of
# CLIENT_URL. Set it when the web app is served from another origin. "*" allows any origin.
# CORS_ORIGINS=http://localhost:8383

# Monitor types to turn off, comma-separated (empty by default). A monitor of one can't be created,
# and existing ones are kept but not checked. For example, "docker" keeps the Docker monitor from
# reading the Docker socket of this machine.
# DISABLED_MONITOR_TYPES=docker

# Keep monitors and notification channels from reaching loopback, private and link-local addresses and cloud metadata
# (169.254.169.254). Off by default, since a self-hosted install usually monitors its own network.
# A remote probe blocks them too when the server it connects to has this on.
# BLOCK_PRIVATE_TARGETS=true

# Cap the requests per minute a workspace, and one of its API keys, may make. A request over either
# answers 429 with Retry-After. 0, the default, is off. Each api replica counts for itself. Requests
# outside a workspace (/me, /auth/*, /admin/*) are not counted.
# API_RATE_LIMIT_PER_WORKSPACE=600
# API_RATE_LIMIT_PER_API_KEY=120

# Cap the checks per minute to one target host that one checking process runs (the server, or one
# remote probe), all workspaces together. A check whose turn is a few seconds away waits for it;
# a check further out skips that tick. 0, the default, is off. A remote probe uses the server's
# value too when that is stricter.
# CHECKS_PER_HOST_PER_MINUTE=60

# The smallest check interval and retry interval, in seconds, that a monitor can be saved with. 20,
# the default, is the smallest a monitor can have; a lower value stops startup. A save below it is
# refused with a 400, and a monitor stored with less is checked at the minimum.
# MIN_CHECK_INTERVAL=60

# A workspace's limits, for a workspace that has none of its own (an instance admin can give it
# some). Unset or 0, the default, is no limit, so an install that sets none has no limits. A write
# over one answers 403 with the code LIMIT_REACHED. Active monitors over the limit (it was lowered)
# are kept but not run, the newest first. The minimum check interval applies beside
# MIN_CHECK_INTERVAL: the stricter wins. The last five are enforced from a later release.
# WORKSPACE_LIMIT_MONITORS=10
# WORKSPACE_LIMIT_MIN_CHECK_INTERVAL=300
# WORKSPACE_LIMIT_PROBES_PER_MONITOR=2
# WORKSPACE_LIMIT_STATUS_PAGES=1
# WORKSPACE_LIMIT_CUSTOM_DOMAINS=1
# WORKSPACE_LIMIT_MEMBERS=3
# WORKSPACE_LIMIT_OWNED_WORKSPACES=1
# WORKSPACE_LIMIT_RETENTION_DAYS=30

# How a member of a suspended workspace gets in touch with whoever runs the install: free text, an
# email address or a URL. GET /me returns it for the banner a suspended workspace shows. Unset by
# default.
# SUPPORT_CONTACT=support@example.com
