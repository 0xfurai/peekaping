DB_USER=root
DB_PASS=password
DB_NAME=peekaping
DB_HOST=localhost
DB_PORT=5432
DB_TYPE=postgres
# MongoDB storage is deprecated: https://docs.peekaping.com/self-hosting/docker-with-mongo
# DB_PORT=27017
# DB_TYPE=mongo

SERVER_PORT=8034
CLIENT_URL="http://localhost:5173"

MODE=dev # logging
TZ="America/New_York"


REDIS_HOST="localhost"
REDIS_PORT=6381
# Redis ACL user; leave empty for password-only/default user auth
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_DB=0

# Set to true to expose the unauthenticated Prometheus /metrics endpoint (off by default).
# METRICS_ENABLED=false
